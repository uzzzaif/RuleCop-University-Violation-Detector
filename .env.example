# Copy this file to .env and replace the password before running the app.

DB_HOST=localhost
DB_PORT=3306
DB_USER=rulecop
DB_PASSWORD=change_this_password
DB_NAME=university_violations

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

CAMERA_INDEX=0

# Optional detector settings. These defaults preserve the original behavior.
YOLO_CONFIDENCE=0.3
YOLO_MODEL=yolov8n.pt
USE_ML_MODEL=false
MODEL_PATH=models/uniform_model.pkl
UNIFORM_RATIO_THRESHOLD=0.25
MIN_CONFIDENCE=0.6
LOITERING_ENABLED=true
LOITERING_TIME=30
LOITERING_MOVEMENT_THRESHOLD=25
FRAME_SKIP=5
DISPLAY_WIDTH=1280
SAVE_SNAPSHOTS=true
SNAPSHOT_DIR=violation_snapshots
